{
  "manifest_version": 3,
  "name": "Hide YouTube Sign Out",
  "version": "1.0",
  "description": "Hides the Sign out button on YouTube to prevent accidental logouts",
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://studio.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.jpeg",
    "32": "icon32.jpeg",
    "48": "icon48.jpeg",
    "128": "icon128.jpeg"
  }
}